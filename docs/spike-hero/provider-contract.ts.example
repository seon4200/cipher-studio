/**
 * Contrato de diseño para descargas por vídeo. No se importa desde producción:
 * el futuro Asset Engine reutilizará proyectos/<id>/materiales/assets/, no Git.
 */
type AssetProviderKind =
  | 'icon'
  | 'illustration'
  | 'transparent-png'
  | 'photo'
  | 'video'
  | 'generated'

type AutomationLevel =
  | 'official-api'
  | 'official-package'
  | 'official-cdn'
  | 'official-repo'
  | 'public-page-controlled'
  | 'browser-assisted'
  | 'manual-only'
  | 'disabled-risk'

/** Estado de evidencia, no permiso automático ni capacidad técnica. */
type VerificationState =
  | 'verified'
  | 'claimed'
  | 'per-asset'
  | 'unknown'
  | 'not-applicable'

type ProviderPolicy = {
  id: string
  name: string
  kinds: AssetProviderKind[]
  automationLevel: AutomationLevel
  hasPublicApi: boolean
  requiresApiKey: boolean
  /** Capacidad observada o documentada del proveedor. */
  catalogAccessSupported: boolean
  onDemandDownloadSupported: boolean
  /** Política de producto: puede ser false aunque el proveedor lo permita. */
  catalogDownloadEnabled: boolean
  onDemandDownloadEnabled: boolean
  maxDownloadsPerVideoFuture: number
  commercialUseStatus: VerificationState
  attributionStatus: VerificationState
  rawRedistributionStatus: VerificationState
  requiresIndividualReview: boolean
  needsBackgroundRemovalByDefault: boolean
  rightsRiskDefault: 'low' | 'medium' | 'high'
  notes: string[]
}

