{
  "name": "cipher-studio",
  "version": "1.0.0",
  "description": "CIPHER Studio - AI Video Editor",
  "main": "dist-electron/main/index.js",
  "author": "John Benites",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:animation-panel-flow": "node tests/aceptacion/animation-panel-flow/contracts.cjs",
    "test:animation-build-queue": "node tests/animation-build-queue.js",
    "test:animation-chat": "node tests/aceptacion/animation-chat/contracts.cjs && node tests/aceptacion/animation-chat/graphics-placement.cjs && node tests/aceptacion/animation-chat/transcript-window.cjs && node tests/aceptacion/animation-chat/scene-module-contract.cjs && node tests/aceptacion/animation-chat/tool-schema-contract.cjs && node tests/aceptacion/animation-chat/codex-app-server-resume-recovery.cjs && node tests/aceptacion/animation-chat/scene-template-source-edits.cjs && node tests/aceptacion/animation-chat/style-library.cjs && node tests/aceptacion/animation-chat/raw-canvas-capture.cjs",
    "test:animation-chat-bundle": "node tests/aceptacion/animation-chat/runtime-bundle.cjs",
    "test:build-graphics": "node tests/build-graphics-planner.js",
    "smoke:animation-codex": "node tests/aceptacion/animation-chat/codex-app-server-smoke.cjs",
    "preview": "vite preview",
    "test": "node tests/todas.js",
    "test:persistencia": "electron tests/persistencia.js",
    "test:assets-persistencia": "electron tests/assets-persistencia.js",
    "test:via4": "electron tests/via4.js",
    "test:materiales": "electron tests/materiales.js",
    "test:graficos": "electron tests/graficos.js",
    "test:reparto": "electron tests/reparto.js",
    "test:exclusion": "electron tests/exclusion.js",
    "test:ciclo": "electron tests/ciclo.js",
    "test:mapa": "electron tests/mapa.js",
    "test:avisos": "electron tests/avisos.js",
    "bench:graficos": "electron tests/rendimiento/graficos.js",
    "test:ventana": "electron tests/ventana.js",
    "test:vibes": "python -m unittest discover -s tests/vibes_clips -v",
    "test:build-integrity": "node tests/build-integrity.js",
    "test:build-stock": "node tests/build-stock.js"
  },
  "dependencies": {
    "@babel/helper-string-parser": "7.29.7",
    "@babel/helper-validator-identifier": "7.29.7",
    "@babel/parser": "7.29.7",
    "@babel/types": "7.29.7",
    "@fal-ai/client": "^1.10.1",
    "gl-transition": "^2.1.0",
    "gl-transitions": "^1.71.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "playwright-core": "^1.62.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "files": [
      "dist/**",
      "!dist/win-unpacked/**",
      "dist-electron/main/**",
      "dist-electron/preload/**",
      "src/prompt-maestro.txt",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vibes_clips",
        "to": "vibes-bot/vibes_clips",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "requirements-vibes.txt",
        "to": "vibes-bot/requirements-vibes.txt"
      }
    ]
  }
}
